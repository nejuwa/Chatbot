NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql://postgres:password@localhost:5432/chatbot
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
HISTORY_WINDOW=20
SYSTEM_PROMPT="You are a helpful assistant."

AUTH_REFRESH_COOKIE_NAME=refresh_token
REFRESH_TOKEN_DAYS=30
AUTH_ACCESS_TOKEN_SECONDS=900

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_URL=http://localhost:3000/reset-password

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
POSTGRES_PASSWORD=
TEST_DATABASE_URL=
